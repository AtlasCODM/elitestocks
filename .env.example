# Required only for trusted financial/admin operations; server-side only.
# Never expose this service-role credential to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Required only by the existing authenticated investment processor/scheduled job.
# Keep server-side and separate from Supabase credentials.
INVESTMENT_JOB_SECRET=

# Optional server-side feature flags. Omitted values default to false.
MAINTENANCE_MODE=false
IN_APP_SUPPORT=false
