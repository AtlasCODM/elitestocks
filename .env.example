# Optional complete public override pair. Defaults come from supabase.public.config.json.
# Without any valid public connection, public pages still render; live auth is unavailable.
SUPABASE_URL=

# Optional browser-safe publishable/anon key for the URL above (SUPABASE_ANON_KEY also accepted).
# Set both public overrides together. Never supply a secret/service-role key here.
SUPABASE_PUBLISHABLE_KEY=

# Required only for existing trusted financial/admin operations that use the service-role client.
# Never expose this value to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Required only by the existing investment processor/scheduled job, when that processor is enabled.
# Keep this server-only and separate from Supabase credentials.
INVESTMENT_JOB_SECRET=

# Optional server-side feature flags. Omitted values default to false.
MAINTENANCE_MODE=false
IN_APP_SUPPORT=false

# Legacy compatibility only. Prefer the unprefixed server variables above. These may be supplied to
# older Vite deployments and are never used as a frontend process.env fallback.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_ANON_KEY=
# VITE_MAINTENANCE_MODE=false
# VITE_FEATURE_IN_APP_SUPPORT=false
